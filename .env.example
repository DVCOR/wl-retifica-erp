# Copie para .env.local e preencha com os dados do projeto Supabase.

# --- Modo de operação ------------------------------------------------------
# "true" = MODO LOCAL (offline): o sistema roda num computador da oficina, sem
# internet, acessado só pela rede local. Sem link público para o cliente, sem
# login por e-mail, usuários criados pelo dono. É o padrão do produto.
# Qualquer outro valor = nuvem (convite por e-mail, link público do cliente).
# Variável NEXT_PUBLIC_: vale no build; troque e gere o build de novo.
NEXT_PUBLIC_MODO_LOCAL=true

# --- Supabase --------------------------------------------------------------
# URL que o NAVEGADOR usa. Na instalação da oficina (deploy/local) é a mesma
# origem HTTPS do app (ex.: https://wl.local) e é preenchida sozinha pelo
# docker compose a partir de deploy/local/.env — não use este arquivo lá.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
# Só no servidor. Opcional: URL que o SERVIDOR do Next usa para falar com o
# Supabase (ex.: http://kong:8000 dentro do Docker). Vazio = usa a URL pública.
SUPABASE_URL_INTERNA=
# Só no servidor. Nunca importar em código de cliente. No modo local também
# cria usuários e redefine senhas (API admin do GoTrue).
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# --- App -------------------------------------------------------------------
# URL do app (QR da etiqueta; na nuvem, também convites e link da OS pública).
# Na instalação da oficina (deploy/local): a mesma origem, ex.: https://wl.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
